# ─── قاعدة البيانات ─────────────────────────────────────────────
# رابط PostgreSQL — محليًا استخدم القيمة أدناه،
# وفي الإنتاج ضع رابط Supabase (وضع Session Pooler)
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/app_db"

# ─── الأمان ────────────────────────────────────────────────────
# كلمة مرور لوحة تحكم الإدارة — غيّرها فورًا!
ADMIN_PASSWORD="change-this-admin-password"

# كلمة مرور صفحة الاستقبال — غيّرها قبل الاستخدام الفعلي
RECEPTION_PASSWORD="change-this-reception-password"

# مفتاح توقيع الجلسات — أنشئه عشوائيًا بطول 32+ حرفًا
# مثال توليد: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# للمعاينة البصرية فقط — اتركها false في الإنتاج
PREVIEW_MODE="false"
